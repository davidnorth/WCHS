<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% if metaTitle %}
    {% set pageTitle = metaTitle %}
  {% elif title and title != site.name %}
    {# Keep the brand suffix only when the title still fits comfortably. #}
    {% if (title + " | " + site.name) | length <= 65 %}
      {% set pageTitle = title + " | " + site.name %}
    {% else %}
      {% set pageTitle = title %}
    {% endif %}
  {% else %}
    {% set pageTitle = site.name %}
  {% endif %}
  {% set pageDescription = description or site.description %}
  {% set socialImage = ogImage or site.ogImage %}
  {% set socialImageAlt = ogImageAlt or site.name %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {% if noindex %}
  <meta name="robots" content="noindex">
  {% else %}
  <meta name="robots" content="max-image-preview:large">
  {% endif %}

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#853023">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_GB">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:image" content="{{ site.url }}{{ socialImage }}">
  {% if not ogImage %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% endif %}<meta property="og:image:alt" content="{{ socialImageAlt }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url }}{{ socialImage }}">

  <script type="application/ld+json">{{ site.organization | toJson | safe }}</script>
  {% if schema %}<script type="application/ld+json">{{ schema | toJson | safe }}</script>{% endif %}

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="preload" href="/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/main.css">
  <script type="module" src="/js/main.js"></script>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" data-controller="nav">
  <div>
    <a class="site-logo" href="/">
          <img src="/images/logo.svg" alt="Wiveliscombe Civic and Historical Society" width="185" height="50">
    </a>
    <nav class="site-nav" aria-label="Primary">
      <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
        <span class="visually-hidden">Menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="4" y1="6" x2="20" y2="6"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="18" x2="20" y2="18"/>
        </svg>
      </button>
      <ul id="primary-nav" role="list">
        {% for item in site.nav %}
        {% set isCurrent = page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li><a href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

<main id="main">
  {{ content | safe }}
</main>

<footer class="site-footer">
  <div>
    <p>&copy; {{ site.name }}. All rights reserved.</p>
    <nav aria-label="Footer">
      <ul role="list">
        <li><a href="/about/">About</a></li>
        <li><a href="/community-matters/">Community Matters</a></li>
        <li><a href="/wivey-talks/">Wivey Talks</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>

</body>
</html>
