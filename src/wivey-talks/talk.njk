---
pagination:
  data: events
  size: 1
  alias: event
permalink: /wivey-talks/{{ event.id }}/
layout: article.njk
eleventyComputed:
  title: "{{ event.title }}"
  description: "{{ event.title }} — {{ event.speaker or 'Wivey Talks' }}. {{ event.date }}"
---

<h1>{{ event.title }}</h1>

<p class="cluster">
  <strong>
    {%- set d = event.date.split('-') -%}
    {{- d[2] }}/{{ d[1] }}/{{ d[0] -}}
  </strong>
  &mdash; {{ event.time }}
</p>

{% if event.speaker %}
<p>With <strong>{{ event.speaker }}</strong>{% if event.speakerRole %}, {{ event.speakerRole }}{% endif %}</p>
{% endif %}

<p>{{ event.description }}</p>

<h2>Venue</h2>
<p>St Andrew's Church, Wiveliscombe. Doors open 7:00pm, talk starts at 7:30pm.</p>

<h2>Admission</h2>
<p>Free to members. Visitors &pound;5 on the door.</p>

{% if event.tags.length %}
<p class="cluster">
  {% for tag in event.tags %}
  <span class="tag">{{ tag }}</span>
  {% endfor %}
</p>
{% endif %}

<p style="margin-block-start: var(--space-lg);"><a href="/wivey-talks/">&larr; Back to all talks</a></p>
