---
layout: base.njk
title: Wivey Talks
description: A programme of talks on subjects of general and community interest in Wiveliscombe.
---

<section class="section flow">
  <h1>Wivey Talks</h1>

  <p>All talks are at St Andrew's Church, Wiveliscombe and start at 7:30pm. Doors open 7:00pm.</p>

  <p>Admission free to members with annual subscriptions of &pound;12 per person or &pound;16 for two people at the same address. Visitors &pound;5.</p>

  <h2>Upcoming Talks</h2>

  <div class="talk-list">
    {% for event in events %}
    <article>
      <img
        src="{{ event.image }}-800.jpg"
        srcset="{{ event.image }}-400.jpg 400w,
                {{ event.image }}-800.jpg 800w,
                {{ event.image }}-1200.jpg 1200w"
        sizes="(min-width: 60rem) 18rem, (min-width: 40rem) 30vw, 100vw"
        width="1200" height="900"
        alt=""
        loading="lazy">
      <div>
        <p>
          <time datetime="{{ event.date }}">
            {%- set d = event.date.split('-') -%}
            {{- d[2] }}/{{ d[1] }}/{{ d[0] -}}
          </time>
          &mdash; {{ event.time }}
        </p>
        <h3><a href="/wivey-talks/{{ event.id }}/">{{ event.title }}</a></h3>
        <p>{{ event.description }}</p>
        {% if event.speaker %}
        <p>With <strong>{{ event.speaker }}</strong>{% if event.speakerRole %}, {{ event.speakerRole }}{% endif %}</p>
        {% endif %}
        <a href="/wivey-talks/{{ event.id }}/">More details</a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
